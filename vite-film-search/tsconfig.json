{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "paths": {
      "ui": ["ui"],
      "types": ["types"],
      "assets": ["assets"],
      "services": ["services"],
      "store": ["store"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
